<?xml version="1.0" encoding="UTF-8"?>
<!--
    LineageOS 16.0 for the Samsung Galaxy S5 Exynos (SM-G900H, k3gxx)

    Put this file in .repo/local_manifests/ of a lineage-16.0 checkout:
      repo init -u https://github.com/LineageOS/android.git -b lineage-16.0
      mkdir -p .repo/local_manifests
      curl -o .repo/local_manifests/k3gxx.xml \
        https://raw.githubusercontent.com/stalex91/android_local_manifests_k3gxx/lineage-16.0/k3gxx.xml
      repo sync

    The proprietary files are not published: extract them from a device
    (see README.md), which creates vendor/samsung/k3gxx.
-->
<manifest>
  <remote name="stalex91" fetch="https://github.com/stalex91" revision="lineage-16.0" />

  <!-- Device tree and kernel -->
  <project path="device/samsung/k3gxx" name="android_device_samsung_k3gxx" remote="stalex91" />
  <project path="kernel/samsung/k3gxx" name="android_kernel_samsung_k3gxx" remote="stalex91" />

  <!-- Samsung / Exynos hardware -->
  <project path="hardware/samsung" name="android_hardware_samsung" remote="stalex91" />
  <project path="hardware/samsung_slsi-cm/exynos" name="android_hardware_samsung_slsi-cm_exynos" remote="stalex91" />
  <project path="hardware/samsung_slsi-cm/exynos5" name="android_hardware_samsung_slsi-cm_exynos5" remote="stalex91" />
  <project path="hardware/samsung_slsi-cm/exynos5422" name="android_hardware_samsung_slsi-cm_exynos5422" remote="stalex91" />
  <project path="hardware/samsung_slsi-cm/openmax" name="android_hardware_samsung_slsi-cm_openmax" remote="stalex91" />
  <project path="packages/resources/devicesettings" name="LineageOS/android_packages_resources_devicesettings" remote="github" revision="lineage-16.0" />

  <!-- libstlport built from source for the Samsung RIL -->
  <project path="external/stlport" name="android_external_stlport" remote="stalex91" />

  <!-- LineageOS projects with k3gxx changes -->
  <remove-project name="LineageOS/android_build" />
  <project path="build/make" name="android_build" remote="stalex91" groups="pdk">
    <copyfile src="core/root.mk" dest="Makefile" />
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <remove-project name="LineageOS/android_external_icu" />
  <project path="external/icu" name="android_external_icu" remote="stalex91" groups="pdk" />

  <remove-project name="LineageOS/android_frameworks_av" />
  <project path="frameworks/av" name="android_frameworks_av" remote="stalex91" groups="pdk" />

  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="stalex91" groups="pdk-cw-fs,pdk-fs" />

  <remove-project name="LineageOS/android_hardware_broadcom_wlan" />
  <project path="hardware/broadcom/wlan" name="android_hardware_broadcom_wlan" remote="stalex91" groups="pdk,broadcom_wlan" />

  <remove-project name="LineageOS/android_hardware_interfaces" />
  <project path="hardware/interfaces" name="android_hardware_interfaces" remote="stalex91" groups="pdk" />

  <remove-project name="LineageOS/android_packages_apps_DeskClock" />
  <project path="packages/apps/DeskClock" name="android_packages_apps_DeskClock" remote="stalex91" groups="pdk-fs" />

  <remove-project name="LineageOS/android_packages_apps_Settings" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="stalex91" groups="pdk-fs" />

  <remove-project name="LineageOS/android_packages_apps_SetupWizard" />
  <project path="packages/apps/SetupWizard" name="android_packages_apps_SetupWizard" remote="stalex91" />

  <remove-project name="LineageOS/android_vendor_lineage" />
  <project path="vendor/lineage" name="android_vendor_lineage" remote="stalex91" />
</manifest>
